<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Lukflix</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90' fill='%23e50914'>L</text></svg>" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header class="topbar">
    <div class="brand">LUK<span>FLIX</span></div>
    <nav class="tabs" id="tabs">
      <button class="tab active" data-type="filme">Filmes</button>
      <button class="tab" data-type="serie">Séries</button>
      <button class="tab" data-type="anime">Animes</button>
      <button class="tab" data-type="dorama">Doramas</button>
    </nav>
    <div class="actions">
      <form class="search" id="searchForm">
        <input type="text" id="searchInput" placeholder="Buscar filme, série, anime..." autocomplete="off" />
        <button type="submit" aria-label="Buscar">🔍</button>
      </form>
      <button class="icon-btn" id="settingsBtn" title="Configurações">⚙️</button>
    </div>
  </header>

  <div id="keyBanner" class="banner hidden">
    ⚠️ Adicione sua chave da API do TMDB nas <strong>configurações (⚙️)</strong> para exibir pôsteres e informações.
    <button id="bannerClose">×</button>
  </div>

  <main id="catalog" class="catalog"></main>

  <div id="detailModal" class="modal hidden">
    <div class="modal-backdrop" data-close></div>
    <div class="modal-content">
      <button class="modal-close" data-close>×</button>
      <div id="detailBody" class="detail-body"></div>
    </div>
  </div>

  <div id="settingsModal" class="modal hidden">
    <div class="modal-backdrop" data-close></div>
    <div class="modal-content settings-content">
      <button class="modal-close" data-close>×</button>
      <h2>Configurações</h2>
      <label class="field">
        <span>Chave da API do TMDB</span>
        <input type="text" id="tmdbKeyInput" placeholder="Cole sua chave v3 (api_key)" />
      </label>
      <p class="hint">
        Obtenha uma chave gratuita em
        <a href="https://www.themoviedb.org/settings/api" target="_blank" rel="noopener">themoviedb.org/settings/api</a>.
        A chave fica salva apenas neste navegador (localStorage).
      </p>
      <div class="settings-actions">
        <button class="btn primary" id="saveKey">Salvar</button>
        <button class="btn" id="clearKey">Remover</button>
      </div>
      <p id="settingsStatus" class="status"></p>
    </div>
  </div>

  <footer class="footer">
    Lukflix · Conteúdo via SuperFlixAPI · Metadados via TMDB
  </footer>

  <script src="/js/config.js"></script>
  <script src="/js/api.js"></script>
  <script src="/js/app.js"></script>
</body>
</html>
